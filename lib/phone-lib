# phone-lib: shared by phone-pull, phone, phone-session and actions/*. Source it; don't run it.
# Never deletes local files. Phone files are only deleted by trim, after you type "yes".

# Defaults; override any of these in the config file (see config.example).
CAM=/sdcard/DCIM/Camera
ROOT=/data/phone
CLIPS=/data/footage/clips
LOG=$HOME/.local/state/phone-pull.log
KEEP_DAYS=60
MENU_MONITOR=eDP-1
LIB=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
CONFIG=${PHONE_CONFIG:-$HOME/.config/phone/config}
[[ -f $CONFIG ]] && . "$CONFIG"
SYNC=${SYNC:-$ROOT/sync}                 # laptop side of the audio sync: $SYNC/Audiobooks, $SYNC/Music
SYNC_MANIFEST=$ROOT/.sync-manifest         # what was in sync after the last run (outside the synced folders)
PULLED=$ROOT/.pulled
TMP=$ROOT/.tmp

export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}
mkdir -p "$(dirname "$LOG")" "$TMP" "$ROOT/photos" "$ROOT/videos" "$CLIPS"
touch "$PULLED"

log()    { printf '%s %s\n' "$(date '+%F %T')" "$*" | tee -a "$LOG" >&2; }
notify() { notify-send -a phone-pull -i phone "$1" "$2" 2>/dev/null || true; }
human()  { numfmt --to=iec --suffix=B "${1:-0}"; }
say()    { printf '\n\033[1m%s\033[0m\n' "$*"; }

wait_for_phone() {
  timeout 30 adb -d wait-for-device 2>/dev/null && return 0
  log "ERROR: phone not found in adb within 30s (plugged in? USB debugging authorised?)"
  notify "phone-pull failed" "phone not found in adb within 30s"
  return 1
}

# Prints "size<TAB>mtime<TAB>name" for each visible file in the camera folder.
list_phone() {
  adb -d shell "find $CAM -maxdepth 1 -type f ! -name '.*' -exec stat -c '%s	%Y	%n' {} +" \
    | tr -d '\r' | sed "s#\t$CAM/#\t#" | sort -t$'\t' -k3
}

is_pulled() { grep -Fxq -- "$1|$2" "$PULLED"; }   # name|size

# Snap a nominal rate like 60000/1001 (or 59.9/1) to the nearest standard rate, as an exact fraction.
snap_fps() {
  awk -v r="$1" 'BEGIN {
    split(r, f, "/"); v = f[1] / (f[2] ? f[2] : 1)
    n = split("24000/1001 24/1 25/1 30000/1001 30/1 50/1 60000/1001 60/1 120/1 240/1", s, " ")
    best = ""; bd = 1e9
    for (i = 1; i <= n; i++) { split(s[i], q, "/"); d = (q[1]/q[2] - v); if (d < 0) d = -d; if (d < bd) { bd = d; best = s[i] } }
    print best }'
}

# Make a constant-frame-rate, edit-ready h264/AAC copy of $1 (mtime $2) in $CLIPS/<date>/.
make_clip() {
  local src=$1 mtime=$2 dir out part fps r a
  dir=$CLIPS/$(date -d "@$mtime" +%F); mkdir -p "$dir"
  out=$dir/$(basename "${src%.*}").mp4; part=$out.part
  [[ -e $out ]] && { log "clip exists, skipping: $out"; return 0; }

  # Nominal rate (r_frame_rate), not avg_frame_rate: dropped frames pull the average down (e.g. 58.9).
  fps=$(ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate -of csv=p=0 "$src")
  [[ -n $fps && $fps != 0/0 ]] || { log "no frame rate for $src"; return 1; }
  fps=$(snap_fps "$fps")

  local common=(-map 0:v:0 -map '0:a:0?' -vf "fps=$fps" -fps_mode cfr -r "$fps"
                -pix_fmt yuv420p -c:a aac -b:a 256k -movflags +faststart -f mp4)
  if ! ffmpeg -nostdin -v error -y -i "$src" "${common[@]}" \
        -c:v h264_nvenc -preset p7 -tune hq -rc vbr -cq 16 -b:v 0 -profile:v high "$part"; then
    log "nvenc failed for $src, falling back to libx264"
    ffmpeg -nostdin -v error -y -i "$src" "${common[@]}" \
        -c:v libx264 -crf 16 -preset slow -profile:v high "$part" || { rm -f "$part"; return 1; }
  fi

  r=$(ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate   -of csv=p=0 "$part")
  a=$(ffprobe -v error -select_streams v:0 -show_entries stream=avg_frame_rate -of csv=p=0 "$part")
  if [[ $r == "$a" && $r == "$fps" ]]; then
    mv "$part" "$out"; log "clip ok ($r): $out"
  else
    mv "$part" "$out.unverified"; log "clip NOT constant fps (want=$fps r=$r avg=$a): $out.unverified"; return 1
  fi
}

# pull_new [--no-clips]: copy new photos/videos, verify md5, record in .pulled. Shows per-file progress.
pull_new() {
  local clips_on=1; [[ ${1:-} == --no-clips ]] && clips_on=0
  exec 9>"$(dirname "$LOG")/phone-pull.lock"
  flock -n 9 || { log "another pull is running"; return 0; }
  wait_for_phone || return 1

  local photos=0 videos=0 clips=0 failed=0 old=0 cutoff size mtime name
  cutoff=$(( $(date +%s) - KEEP_DAYS*86400 ))
  local listing; listing=$(list_phone) || { log "ERROR: could not list $CAM"; return 1; }
  log "phone has $(wc -l <<<"$listing") files in camera folder"

  local -a todo=()                              # new files only
  while IFS=$'\t' read -r size mtime name; do
    [[ -n $name ]] || continue
    if is_pulled "$name" "$size"; then (( mtime < cutoff )) && old=$((old+1)); else todo+=("$size"$'\t'"$mtime"$'\t'"$name"); fi
  done <<<"$listing"

  say "=== PULLING ${#todo[@]} NEW FILES — DO NOT UNPLUG THE PHONE ==="
  local i=0 kind ym dest tmp want got dest_name
  for entry in "${todo[@]}"; do
    IFS=$'\t' read -r size mtime name <<<"$entry"; i=$((i+1))
    case ${name,,} in *.mp4|*.mov|*.mkv|*.3gp) kind=videos ;; *) kind=photos ;; esac
    ym=$(date -d "@$mtime" +%Y/%m); dest=$ROOT/$kind/$ym; mkdir -p "$dest"; tmp=$TMP/$name

    printf '[%d/%d] %s (%s)\n' "$i" "${#todo[@]}" "$name" "$(human "$size")"
    adb -d pull -a "$CAM/$name" "$tmp" >&2 || { log "pull failed: $name"; failed=$((failed+1)); continue; }
    printf '        verifying md5...\r'
    want=$(adb -d shell "md5sum '$CAM/$name'" | tr -d '\r' | cut -d' ' -f1)
    got=$(md5sum "$tmp" | cut -d' ' -f1)
    if [[ -z $want || $want != "$got" ]]; then
      log "CHECKSUM MISMATCH $name (phone=$want local=$got), left in $tmp"; failed=$((failed+1)); continue
    fi

    dest_name=$name                              # never overwrite: same content is fine, else keep both
    if [[ -e $dest/$name && $(md5sum < "$dest/$name" | cut -d' ' -f1) != "$got" ]]; then
      dest_name="${name%.*}-${got:0:8}.${name##*.}"
    fi
    [[ -e $dest/$dest_name ]] || mv -n "$tmp" "$dest/$dest_name"
    [[ -e $tmp ]] && rm -f "$tmp"                # only if an identical copy was already in place
    echo "$name|$size" >> "$PULLED"
    log "pulled $kind/$ym/$dest_name ($(human "$size")) md5 ok"

    if [[ $kind == videos ]]; then
      videos=$((videos+1))
      if (( clips_on )); then
        if make_clip "$dest/$dest_name" "$mtime"; then clips=$((clips+1)); else failed=$((failed+1)); fi
      fi
    else photos=$((photos+1)); fi
  done

  local msg="$photos photos, $videos videos pulled"
  (( clips_on )) && msg+=", $clips clips converted"
  (( failed )) && msg+=", $failed FAILED (see log)"
  msg+=$'\n'"$old phone files older than $KEEP_DAYS days already backed up (--trim)"
  log "done: ${msg//$'\n'/; }"
  notify "Phone pull complete" "$msg"
  local bad=""; (( failed )) && bad=", $failed FAILED"
  say "=== PULL FINISHED ($photos photos, $videos videos$bad) — safe to unplug ==="
  (( failed == 0 ))
}

trim() {
  local days=${1:-$KEEP_DAYS} cutoff n=0 total=0 size mtime name ans
  [[ $days =~ ^[0-9]+$ ]] || { echo "days must be a number"; return 1; }
  wait_for_phone || return 1
  cutoff=$(( $(date +%s) - days*86400 ))
  local -a victims=()
  while IFS=$'\t' read -r size mtime name; do
    (( mtime < cutoff )) && is_pulled "$name" "$size" || continue
    victims+=("$name"); n=$((n+1)); total=$((total+size))
    printf '%s  %8s  %s\n' "$(date -d "@$mtime" +%F)" "$(human "$size")" "$name"
  done < <(list_phone)
  echo "$n files older than $days days, already pulled, $(human "$total") total"
  (( n )) || return 0
  read -r -p "Delete these from the phone? Type yes: " ans
  [[ $ans == yes ]] || { echo "aborted, nothing deleted"; return 0; }
  for name in "${victims[@]}"; do
    adb -d shell "rm '$CAM/$name'" && log "trim: deleted from phone: $name"
  done
}

# Rebuild clips left as *.mp4.unverified; the old file is kept, renamed *.superseded.
redo_clips() {
  local bad out base src
  while IFS= read -r bad; do
    out=${bad%.unverified}; base=$(basename "${out%.mp4}")
    src=$(find "$ROOT/videos" -type f -name "$base.*" | head -n1)
    [[ -n $src ]] || { log "redo: no source video for $bad"; continue; }
    if make_clip "$src" "$(stat -c %Y "$src")"; then mv "$bad" "$bad.superseded"; fi
  done < <(find "$CLIPS" -name '*.mp4.unverified' | sort)
  log "redo-clips finished"
}

# ---- scrcpy / monitors -------------------------------------------------------------------------

# monitor_pos SERIAL_OR_CONNECTOR -> "x y" of that monitor's top-left (Mutter logical coords), or fails.
monitor_pos() {
  gdbus call --session --dest org.gnome.Mutter.DisplayConfig --object-path /org/gnome/Mutter/DisplayConfig \
      --method org.gnome.Mutter.DisplayConfig.GetCurrentState 2>/dev/null |
  python3 -c '
import re, sys
want = sys.argv[1]
t = sys.stdin.read()
for m in re.finditer(r"\((-?\d+), (-?\d+), [\d.]+, (?:uint32 )?\d+, (?:true|false), \[\(\x27([^\x27]+)\x27, \x27[^\x27]*\x27, \x27[^\x27]*\x27, \x27([^\x27]*)\x27\)\]", t):
    x, y, conn, serial = m.groups()
    if want in (conn, serial): print(x, y); sys.exit(0)
sys.exit(1)' "$1"
}

# scrcpy runs as its own transient user unit, so it outlives the menu and the session service.
# It exits by itself when the phone is unplugged.
scrcpy_running() { systemctl --user is-active --quiet phone-scrcpy; }
stop_scrcpy()    { systemctl --user stop phone-scrcpy 2>/dev/null; }

# Fullscreen scrcpy (via XWayland) on the Dell found by serial; else on the laptop screen; else not at all.
start_scrcpy() {
  scrcpy_running && { echo "scrcpy is already running"; return 0; }
  systemctl --user reset-failed phone-scrcpy 2>/dev/null
  local pos where
  if pos=$(monitor_pos "$SCRCPY_MONITOR_SERIAL"); then where="Dell $SCRCPY_MONITOR_SERIAL"
  elif pos=$(monitor_pos "$SCRCPY_FALLBACK_CONNECTOR"); then where="$SCRCPY_FALLBACK_CONNECTOR (Dell not connected)"
  else log "no usable monitor for scrcpy, not starting it"; return 1; fi
  set -- $pos; log "scrcpy -> $where at +$1+$2"
  systemd-run --user --quiet --unit=phone-scrcpy --collect \
      ${DISPLAY:+--setenv=DISPLAY="$DISPLAY"} ${XAUTHORITY:+--setenv=XAUTHORITY="$XAUTHORITY"} \
      env SDL_VIDEODRIVER=x11 "${SCRCPY_BIN:-scrcpy}" --window-title=phone-scrcpy --window-x="$1" --window-y="$2" --fullscreen --stay-awake \
      9>&- >/dev/null 2>&1 || { log "systemd-run failed to start scrcpy"; return 1; }
  "$LIB/xplace" fullscreen phone-scrcpy "$1" "$2" 9>&- >/dev/null 2>&1 &   # make sure fullscreen is on that monitor
}

# open_menu_window: kitty on $MENU_MONITOR at kitty's default size (remember_window_size=no; position hint plus xplace move once mapped).
open_menu_window() {
  local pos x=0 y=0 cmd=$1
  if pos=$(monitor_pos "$MENU_MONITOR"); then set -- $pos; x=$(($1+50)); y=$(($2+50)); fi
  "$LIB/xplace" move phone-menu "$x" "$y" 9>&- 8>&- >/dev/null 2>&1 &   # Mutter ignores --position; ask it to move
  kitty -o linux_display_server=x11 -o remember_window_size=no --start-as=normal --position="${x}x${y}" --title phone-menu "$cmd" 8>&- 9>&-
}

# ---- audio sync (laptop is the source of truth) --------------------------------------------------
# Laptop $SYNC/{Audiobooks,Music}  <->  phone /sdcard/{Audiobooks,Music}. Nothing else on the phone is touched.
#   laptop only                      -> push
#   phone only, in manifest          -> you deleted it on the laptop: delete from phone after you type yes
#   phone only, not in manifest      -> new on the phone: pull into the laptop folder
#   both, different size             -> reported, left alone
# The manifest ($SYNC_MANIFEST) is rewritten at the end of every run with what is now in sync.
SYNC_DIRS=(Audiobooks Music)

shq() { local q=${1//\'/\'\\\'\'}; printf "'%s'" "$q"; }   # quote for the phone's sh (handles apostrophes)

# sync_audio [--dry-run]
sync_audio() {
  local dry=0; [[ ${1:-} == --dry-run ]] && dry=1
  wait_for_phone || return 1
  local T=$'\t' sub rel size psize
  local -A L=() P=() M=()          # key "Sub/rel" -> size
  local -a push=() pull=() del=() differ=() keep=()

  for sub in "${SYNC_DIRS[@]}"; do
    if [[ ! -d $SYNC/$sub ]]; then
      if [[ -e $SYNC_MANIFEST ]] && grep -q "^$sub/" "$SYNC_MANIFEST"; then
        log "audio: ERROR $SYNC/$sub is missing but the manifest knows it (drive not mounted?), refusing to sync"; return 1
      fi
      mkdir -p "$SYNC/$sub"
    fi
    while IFS=$'\t' read -r size rel; do
      [[ -n $rel ]] || continue
      L["$sub/$rel"]=$size
    done < <(cd "$SYNC/$sub" && find . -type f -printf '%s\t%P\n')
    local out; out=$(adb -d shell "if [ -d /sdcard/$sub ]; then find /sdcard/$sub -type f -exec stat -c '%s	%n' {} +; fi; echo __END__" | tr -d '\r') \
      || { log "audio: ERROR could not list /sdcard/$sub"; return 1; }
    [[ $out == *__END__ ]] || { log "audio: ERROR incomplete listing of /sdcard/$sub"; return 1; }
    while IFS=$'\t' read -r size rel; do
      [[ $rel == /sdcard/$sub/* ]] && P["$sub/${rel#/sdcard/$sub/}"]=$size
    done <<<"$out"
  done
  if [[ -e $SYNC_MANIFEST ]]; then
    while IFS=$'\t' read -r rel size; do [[ -n $rel ]] && M["$rel"]=$size; done < "$SYNC_MANIFEST"
  fi

  local k
  while IFS= read -r k; do
    [[ -n $k ]] || continue
    if   [[ -n ${L[$k]+x} && -z ${P[$k]+x} ]]; then push+=("$k")
    elif [[ -n ${L[$k]+x} && ${L[$k]} == "${P[$k]}" ]]; then keep+=("$k")
    elif [[ -n ${L[$k]+x} ]]; then differ+=("$k"); [[ -n ${M[$k]+x} ]] && keep+=("$k")
    elif [[ -n ${M[$k]+x} ]]; then del+=("$k")
    else pull+=("$k"); fi
  done < <(printf '%s\n' "${!L[@]}" "${!P[@]}" | sort -u)

  local first=""; [[ -e $SYNC_MANIFEST ]] || first=" (first run: phone files are imported into $SYNC)"
  say "Audio sync summary$first"
  printf 'to push (laptop -> phone): %d\n' ${#push[@]}; for k in "${push[@]}"; do printf '    %s  (%s)\n' "$k" "$(human "${L[$k]}")"; done
  printf 'to pull (phone -> laptop): %d\n' ${#pull[@]}; for k in "${pull[@]}"; do printf '    %s  (%s)\n' "$k" "$(human "${P[$k]}")"; done
  printf 'to delete from phone (deleted on laptop): %d\n' ${#del[@]}; for k in "${del[@]}"; do printf '    %s  (%s)\n' "$k" "$(human "${P[$k]}")"; done
  (( ${#differ[@]} )) && { printf 'size differs, left alone: %d\n' ${#differ[@]}; printf '    %s\n' "${differ[@]}"; }
  if (( dry )); then echo "(dry run: nothing changed)"; return 0; fi

  local pushed=0 pulled=0 deleted=0 failed=0 want got tmp
  local -a synced=("${keep[@]}")
  for k in "${push[@]}"; do
    sub=${k%%/*}; rel=${k#*/}
    echo "-> push $k ($(human "${L[$k]}"))"
    adb -d shell "mkdir -p $(shq "$(dirname "/sdcard/$k")")"
    if adb -d push "$SYNC/$k" "/sdcard/$k" >&2; then
      want=$(md5sum < "$SYNC/$k" | cut -d' ' -f1)
      got=$(adb -d shell "md5sum $(shq "/sdcard/$k")" | tr -d '\r' | cut -d' ' -f1)
      if [[ $want == "$got" ]]; then pushed=$((pushed+1)); synced+=("$k"); log "audio: pushed $k md5 ok"; continue; fi
    fi
    failed=$((failed+1)); log "audio: FAILED push $k"
  done
  for k in "${pull[@]}"; do
    echo "<- pull $k ($(human "${P[$k]}"))"
    tmp=$TMP/sync.$$.part; mkdir -p "$(dirname "$SYNC/$k")"
    if adb -d pull "/sdcard/$k" "$tmp" >&2; then
      want=$(adb -d shell "md5sum $(shq "/sdcard/$k")" | tr -d '\r' | cut -d' ' -f1)
      got=$(md5sum < "$tmp" | cut -d' ' -f1)
      if [[ -n $want && $want == "$got" ]] && mv -n "$tmp" "$SYNC/$k" && [[ ! -e $tmp ]]; then
        pulled=$((pulled+1)); synced+=("$k"); log "audio: pulled $k md5 ok"; continue
      fi
    fi
    rm -f "$tmp"; failed=$((failed+1)); log "audio: FAILED pull $k"
  done
  if (( ${#del[@]} )); then
    local ans; read -r -p "Delete these ${#del[@]} files from the phone only? Type yes: " ans
    if [[ $ans == yes ]]; then
      for k in "${del[@]}"; do
        if adb -d shell "rm $(shq "/sdcard/$k")"; then deleted=$((deleted+1)); log "audio: deleted from phone: $k"
        else failed=$((failed+1)); synced+=("$k"); fi
      done
    else echo "not deleted; they stay in the manifest and are offered again next time"; synced+=("${del[@]}"); fi
  fi
  { for k in "${synced[@]}"; do printf '%s\t%s\n' "$k" "${L[$k]:-${P[$k]}}"; done; } | sort > "$SYNC_MANIFEST.new" && mv "$SYNC_MANIFEST.new" "$SYNC_MANIFEST"
  say "Audio: $pushed pushed, $pulled pulled, $deleted deleted from phone, ${#differ[@]} differ (untouched), $failed failed"
  (( failed == 0 ))
}
