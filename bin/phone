#!/usr/bin/env bash
# phone: menu run inside the phone session's kitty. Pulls new originals first, then lists actions/* .
PROJECT=$(dirname "$(dirname "$(readlink -f "$0")")")
. "$PROJECT/lib/phone-lib"

pull_new --no-clips || say "Pull had problems — see $LOG"

while true; do
  actions=("$PROJECT"/actions/*); say "Phone menu"
  for i in "${!actions[@]}"; do
    printf '  %d) %s\n' $((i+1)) "$(sed -n 's/^# menu: //p;T;q' "${actions[$i]}")"   # title from "# menu:" line
  done
  echo "  q) Quit menu (scrcpy keeps running)"
  read -r -p "> " choice || break
  case $choice in
    q|Q) break ;;
    '') ;;
    # 10#: "08" is 8, not an octal error. Bounds-check: a negative index would pick the LAST action.
    *[!0-9]*|??????*) echo "No such entry: $choice" ;;
    *) if (( 10#$choice >= 1 && 10#$choice <= ${#actions[@]} )); then bash "${actions[$((10#$choice-1))]}"; read -r -p "[enter to continue] " _
       else echo "No such entry: $choice (1-${#actions[@]})"; fi ;;
  esac
done
